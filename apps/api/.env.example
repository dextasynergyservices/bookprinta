DATABASE_URL=postgresql://bookprinta:bookprinta_dev@localhost:5432/bookprinta    # Local Docker Postgres (switch to Neon URL for production)
REDIS_URL=redis://localhost:6379   # Local Docker Redis
JWT_SECRET=bookprinta-dev-jwt-secret-change-in-production                    # Neon PostgreSQL connection string
REDIS_URL=                       # Upstash Redis URL
JWT_ACCESS_EXPIRY=15m              # Short-lived access token
JWT_REFRESH_EXPIRY_USER=7d         # Refresh token for regular users
JWT_REFRESH_EXPIRY_ADMIN=1h        # Refresh token for admin roles
REFRESH_TOKEN_HMAC_SECRET=         # Optional dedicated secret for refresh-token digests; falls back to JWT_SECRET
CLAMAV_HOST=clamav                 # ClamAV daemon host (Docker service name)
CLAMAV_PORT=3310                   # ClamAV daemon port
SCANNER_PROVIDER=clamav            # "clamav" (local dev) or "virustotal" (production)
VIRUSTOTAL_API_KEY=                # Required when SCANNER_PROVIDER=virustotal
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
PAYSTACK_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_REQUEST_TIMEOUT_MS=45000
GOTENBERG_URL=http://localhost:3100 # Local Docker Gotenberg; use your hosted URL in staging/production
GOTENBERG_BACKUP_URL=            # Optional failover endpoint (leave empty if you don't have one)
GOTENBERG_USERNAME=
GOTENBERG_PASSWORD=
APP_ENV=development              # development | staging | production
FEATURE_BOOK_WORKSPACE=true      # Default true outside production, false in production unless explicitly enabled
FEATURE_MANUSCRIPT_PIPELINE=true # Upload -> AI format -> server count
FEATURE_BILLING_GATE=true        # Extra-page payment enforcement
FEATURE_FINAL_PDF=true           # Final PDF generation after approval
FEATURE_MANUSCRIPT_ALLOW_IN_FLIGHT=true # Let books already in the pipeline finish during rollback
RESEND_API_KEY=
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_WHATSAPP_FROM=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
RECAPTCHA_SECRET_KEY=
LOG_LEVEL=debug                  # Pino log level (debug/info/warn/error). Defaults: debug (dev), info (prod)
RATE_LIMIT_STORAGE=memory        # "memory" (default, saves Redis quota) or "redis" (distributed, for production)
FRONTEND_URL=                    # For CORS & email links
# Email addresses (used in Resend sending)
CONTACT_FROM_EMAIL=BookPrinta <info@bookprinta.com>   # Contact form: sender address
CONTACT_ADMIN_EMAIL=info@bookprinta.com               # Contact form: admin receives here
QUOTES_FROM_EMAIL=BookPrinta <quotes@bookprinta.com>  # Quotes: sender address
ADMIN_NOTIFICATION_EMAIL=admin@bookprinta.com         # General admin notifications
ADMIN_FROM_EMAIL=BookPrinta <admin@bookprinta.com>
PAYMENT_ADMIN_EMAILS=payments@bookprinta.com

POSTHOG_PROJECT_ID=12345                    # Project ID (for Query API)
POSTHOG_PERSONAL_API_KEY=phx_xxxxx          # Personal API key (PRIVATE — never in browser)
POSTHOG_HOST=https://eu.i.posthog.com       # Same host
# ─────────────────────────────────────────────────────────────
# Phase 0 baseline instrumentation (TEMPORARY)
# See docs/infra-cost-hardening-plan.md — remove both once Phase 1 is verified.
#
# Two INDEPENDENT switches, both default OFF:
#   REDIS_COMMAND_METER=1   → starts counting Redis commands by name (no endpoint)
#   BASELINE_METRICS_TOKEN  → enables GET/POST /api/v1/health/baseline (no counting)
# Set BOTH to capture a baseline. Leave both unset for normal dev — zero overhead.
#
# Generate a strong token:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────
REDIS_COMMAND_METER=              # "1" to enable command counting. Unset = off.
BASELINE_METRICS_TOKEN=           # Bearer token for /health/baseline. Unset = endpoint returns 503.

# ─────────────────────────────────────────────────────────────
# External cron triggers (Phase 1b — PERMANENT)
# Scheduled maintenance is driven by external cron, NOT BullMQ job schedulers.
# A BullMQ scheduler keeps a delayed job permanently pending, which forces its
# worker to long-poll Redis every 10s forever (~1M commands/month).
#
# Configure these two jobs in the same cron account that pings /health/ping:
#   POST /api/v1/cron/production-delay-check   every 15 minutes
#   POST /api/v1/cron/audit-log-archive        daily (e.g. 03:00)
# Auth header (either):  Authorization: Bearer <token>   |   X-Cron-Token: <token>
#
# Generate:  openssl rand -hex 32
# Unset = endpoints return 503 and scheduled maintenance DOES NOT RUN.
# ─────────────────────────────────────────────────────────────
CRON_TRIGGER_TOKEN=               # Shared secret for /api/v1/cron/* endpoints

# ─────────────────────────────────────────────────────────────
# Detailed health status (Phase 2b — PERMANENT)
# GET /api/v1/health/status pings DB/Redis/scanner/queues, and with ?deep=1
# runs a real Gotenberg render. Unauthenticated, an attacker could loop the
# deep check and exhaust the single Gotenberg instance — so it is token-gated.
# /api/v1/health/ping stays PUBLIC (UptimeRobot keep-alive) and is unaffected.
#
# Auth header (either):  Authorization: Bearer <token>  |  X-Health-Token: <token>
# Generate:  openssl rand -hex 32
# Unset = /health/status returns 503 (ping still works).
# ─────────────────────────────────────────────────────────────
HEALTH_STATUS_TOKEN=              # Shared secret for GET /api/v1/health/status
